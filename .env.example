# --- vLLM (tool calling 전용 채팅 모델) ---
# vllm serve <model> --enable-auto-tool-choice --reasoning-parser gemma4 --tool-call-parser gemma4
# 로 띄운 OpenAI 호환 서버 주소. 끝에 /v1 포함.
VLLM_API_BASE=http://localhost:8000/v1
# vLLM은 기본적으로 키를 검사하지 않지만 openai 클라이언트는 빈 문자열을 허용하지 않는다.
VLLM_API_KEY=EMPTY
# 서버가 --served-model-name 등으로 지정한 모델 식별자와 반드시 일치해야 한다.
MEETING_MODEL=gemma4
MEETING_CONTEXT_WINDOW=8192
MEETING_LLM_TIMEOUT=120

# --- OpenAI (임베딩 전용) ---
# gemma4는 임베딩 모델이 아니므로 인덱싱/검색용 임베딩은 여전히 OpenAI 공식 API를 사용한다.
OPENAI_API_KEY=
MEETING_EMBED_MODEL=text-embedding-3-small

MEETING_DATA_DIR=./data
